# BidOnDent Environment Variables
# Copy this file to .env and fill in your values.

# ─── Frontend (Vite) ───────────────────────────────────────────────

# Clerk (required — authentication will not work without this)
VITE_CLERK_PUBLISHABLE_KEY=

# Supabase (required — backend calls will fail without these)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_ANON_KEY=

# Sentry (optional — app works without these, error tracking activates when set)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Admin account switch password (dev only, never hardcode in source)
VITE_ADMIN_SWITCH_PASSWORD=

# Demo mode password (dev only, never hardcode in source)
VITE_DEMO_PASSWORD=

# Demo mode toggle — set to "true" to enable demo data fallback; defaults to false in production
VITE_DEMO_MODE=false

# Map diagnostics overlay (dev only)
# VITE_SHOW_MAP_DIAGNOSTICS=true

# Force demo partner shops on map even when real data is available (dev only)
# VITE_ENABLE_MAP_DEMO_FALLBACK=true

# ─── Backend (Supabase Edge Functions — set in Supabase dashboard) ──

# These are NOT Vite variables. Set them in Supabase project settings
# → Edge Functions → Environment Variables, or via `supabase secrets set`.
#
# SUPABASE_URL            — auto-provided by Supabase
# SUPABASE_ANON_KEY       — auto-provided by Supabase
# SUPABASE_SERVICE_ROLE_KEY — auto-provided by Supabase
# SUPABASE_DB_URL         — auto-provided (used by health check)
# CLERK_SECRET_KEY        — from Clerk dashboard → API Keys
# CLERK_PUBLISHABLE_KEY   — from Clerk dashboard → API Keys
# RESEND_API_KEY          — from Resend dashboard (email delivery)
# EMAIL_FROM_ADDRESS      — sender address (default: BidOnDent <notifications@bidondent.com>)
# SITE_URL                — production URL (default: https://bidondent.com)
# ENVIRONMENT             — "local" for local dev, omit for production
